import { NextRequest, NextResponse } from 'next/server';
import { db } from '@/lib/supabase';
import { getProvider } from '@/lib/pix/provider';

export async function POST(req: NextRequest) {
  const raw = await req.text();
  const provider = getProvider();

  const ev = provider.verifyWebhook(raw, req.headers);
  if (!ev)
    return NextResponse.json({ error: 'assinatura inválida' }, { status: 401 });

  const supa = db();

  const { error } = await supa.from('webhook_events').insert({
    provider: provider.name,
    event_id: ev.eventId,
    payload: JSON.parse(raw),
  });
  if (error?.code === '23505')
    return NextResponse.json({ ok: true, duplicate: true });

  const real = await provider.getCharge(ev.providerChargeId);

  await supa.from('charges').update({
    status: real.status,
    paid_at: real.status === 'paid' ? new Date().toISOString() : null,
  }).eq('provider', provider.name)
    .eq('provider_charge_id', ev.providerChargeId);

  return NextResponse.json({ ok: true });
}
